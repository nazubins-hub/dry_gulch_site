---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Water-wise landscape design and stormwater-informed planting for the Vail Valley.' } = Astro.props;
const year = new Date().getFullYear();
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
</head>
<body>
  <header class="site-header">
    <div class="wrap header-inner">
      <a href="/" class="wordmark">
        <span class="wordmark-main">Dry Gulch Design</span>
        <span class="wordmark-sub">Landscape Architecture &amp; Stormwater Planning</span>
      </a>
      <nav class="site-nav">
        <a href="/portfolio">Portfolio</a>
        <a href="/blog">Journal</a>
        <a href="/about">About</a>
        <a href="/contact" class="btn primary nav-cta">Start a project</a>
      </nav>
    </div>
  </header>

  <main>
    <slot />
  </main>

  <footer class="site-footer">
    <div class="wrap footer-inner">
      <div class="stamp">
        <span class="compass">&#8593;N</span>VAIL VALLEY, CO &middot; 39.6403&deg; N, 106.5455&deg; W &middot; ZONE 5B
      </div>
      <div class="footer-links">
        <a href="/portfolio">Portfolio</a>
        <a href="/blog">Journal</a>
        <a href="/about">About</a>
        <a href="/contact">Contact</a>
      </div>
      <p class="footer-fine">&copy; {year} Dry Gulch Design. Site built with Astro, hosted on Cloudflare Pages.</p>
    </div>
  </footer>
</body>
</html>

<style>
  .site-header {
    border-bottom: 1px solid var(--line);
    background: var(--sand);
    position: sticky;
    top: 0;
    z-index: 10;
  }
  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 1.1rem;
    padding-bottom: 1.1rem;
    gap: 1.5rem;
    flex-wrap: wrap;
  }
  .wordmark {
    text-decoration: none;
    color: var(--basalt);
    line-height: 1.15;
  }
  .wordmark-main {
    display: block;
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 600;
  }
  .wordmark-sub {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--basalt-soft);
  }
  .site-nav {
    display: flex;
    align-items: center;
    gap: 1.6rem;
    font-family: var(--font-mono);
    font-size: 0.85rem;
  }
  .site-nav a {
    text-decoration: none;
    color: var(--basalt);
  }
  .site-nav a:hover { color: var(--sienna); }
  .nav-cta { padding: 0.55rem 1.1rem; }
  .nav-cta:hover { color: var(--sand-light) !important; }

  .site-footer {
    border-top: 1px solid var(--line);
    margin-top: 5rem;
    padding: 2.5rem 0 3rem;
  }
  .footer-inner {
    display: flex;
    flex-direction: column;
    gap: 1.4rem;
  }
  .footer-links {
    display: flex;
    gap: 1.4rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
  }
  .footer-links a { text-decoration: none; color: var(--basalt); }
  .footer-links a:hover { color: var(--sienna); }
  .footer-fine {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--basalt-soft);
    margin: 0;
  }

  @media (max-width: 640px) {
    .site-nav { font-size: 0.78rem; gap: 1rem; }
  }
</style>
