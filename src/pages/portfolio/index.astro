---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const projects = (await getCollection('portfolio', ({ data }) => !data.draft))
  .sort((a, b) => (b.data.year ?? '').localeCompare(a.data.year ?? ''));
---
<BaseLayout title="Portfolio — Dry Gulch Design" description="Landscape architecture and stormwater design projects across the Vail Valley.">
  <section class="wrap">
    <span class="eyebrow">Built Work</span>
    <h1>Portfolio</h1>
    <p class="intro">A record of completed and in-progress designs across the valley &mdash; each one built around how water actually moves through the site.</p>

    <div class="project-grid">
      {projects.map((project) => (
        <a class="card project-card" href={`/portfolio/${project.slug}`}>
          <div>
            <span class="meta-row">
              {project.data.year && <span>{project.data.year}</span>}
              {project.data.elevation && <span>{project.data.elevation}</span>}
            </span>
            <h2>{project.data.title}</h2>
            <p class="loc">{project.data.location}</p>
            <p>{project.data.summary}</p>
          </div>
          <div class="scope-tags">
            {project.data.scope.map((s) => <span class="tag">{s}</span>)}
          </div>
        </a>
      ))}
    </div>
    {projects.length === 0 && (
      <p class="empty-note">Project entries will appear here once added to <code>src/content/portfolio/</code>.</p>
    )}
  </section>
</BaseLayout>

<style>
  .intro { max-width: 620px; color: var(--basalt-soft); font-size: 1.05rem; }
  .project-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
    margin: 2.5rem 0;
  }
  .project-card {
    text-decoration: none;
    color: var(--basalt);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 1.4rem;
    transition: border-color 0.15s ease, transform 0.15s ease;
  }
  .project-card:hover { border-color: var(--sienna); transform: translateY(-2px); }
  .loc {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--sienna);
    margin: 0.2em 0 0.6em;
  }
  .scope-tags { display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .empty-note { font-family: var(--font-mono); font-size: 0.85rem; color: var(--basalt-soft); }

  @media (max-width: 760px) {
    .project-grid { grid-template-columns: 1fr; }
  }
</style>
