---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();
---
<BaseLayout title={`${post.data.title} — Next Steppe`} description={post.data.summary}>
  <article class="wrap post">
    <a href="/blog" class="back-link">&larr; Journal</a>
    <span class="meta-row">
      <span>{post.data.date.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}</span>
      {post.data.tags.map((tag) => <span class="tag">{tag}</span>)}
    </span>
    <h1>{post.data.title}</h1>
    <div class="prose">
      <Content />
    </div>
  </article>
</BaseLayout>

<style>
  .post { padding-top: 2.5rem; padding-bottom: 4rem; max-width: 720px; }
  .back-link {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    text-decoration: none;
    margin-bottom: 1.5rem;
    color: var(--basalt-soft);
  }
  .back-link:hover { color: var(--sienna); }
  h1 { margin-top: 0.6rem; }
  .prose { margin-top: 2rem; }
  .prose :global(h2) { margin-top: 2rem; font-size: 1.4rem; }
  .prose :global(h3) { margin-top: 1.6rem; }
  .prose :global(p) { color: var(--basalt); }
  .prose :global(ul), .prose :global(ol) { padding-left: 1.3rem; }
  .prose :global(li) { margin-bottom: 0.4em; }
  .prose :global(blockquote) {
    border-left: 3px solid var(--sienna);
    margin: 1.6rem 0;
    padding: 0.2rem 0 0.2rem 1.2rem;
    color: var(--basalt-soft);
    font-style: italic;
  }
  .prose :global(code) {
    background: var(--sand-light);
    padding: 0.15em 0.4em;
    border-radius: 2px;
    font-size: 0.9em;
  }
</style>
