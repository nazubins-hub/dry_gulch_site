# Copy this file to .env and fill in your Bose app login.
# The .env file stays on your Mac - it is gitignored and never committed.

# The email + password you use in the Bose Music app
BOSE_EMAIL=you@example.com
BOSE_PASSWORD=your-bose-password

# Optional - leave blank to auto-discover the soundbar on your network.
# Set these if discovery fails (find the IP in the Bose app under
# the soundbar's settings, or in your router's client list).
BOSE_HOST=
BOSE_GUID=

# Port the remote is served on
PORT=8787

# Volume change per tap of + / - (and per Shortcut call)
VOLUME_STEP=5

# Set to 1 to run against a fake soundbar (no credentials needed) - lets you
# try the app in a browser before touching the real device.
MOCK=
