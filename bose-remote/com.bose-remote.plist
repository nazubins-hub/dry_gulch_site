<?xml version="1.0" encoding="UTF-8"?>
<!-- launchd template - install-launchd.sh fills in __DIR__ and copies this
     to ~/Library/LaunchAgents/com.bose-remote.plist -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.bose-remote</string>
    <key>ProgramArguments</key>
    <array>
        <string>__DIR__/run.sh</string>
    </array>
    <key>WorkingDirectory</key>
    <string>__DIR__</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>__DIR__/data/server.log</string>
    <key>StandardErrorPath</key>
    <string>__DIR__/data/server.log</string>
</dict>
</plist>
